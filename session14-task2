program:
import java.util.*;

class Checker implements Comparator<Player> {

    @Override
    public int compare(Player a, Player b) {

        // 1. Sort by score in decreasing order
        if (a.score != b.score) {
            return b.score - a.score;
        }

        // 2. If scores are equal, sort by name alphabetically
        return a.name.compareTo(b.name);
    }
}
